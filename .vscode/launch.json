{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "GD Arena: Run model + UI",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/launch.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "GD Arena: Debug server on port 7861",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "args": ["--port", "7861", "--open-browser"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
