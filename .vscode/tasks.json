{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "GD Arena: Run model + UI",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["launch.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "dedicated"}
    },
    {
      "label": "GD Arena: Download speech model",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["setup_voice.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "GD Arena: Run Python tests",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "unittest", "discover", "-s", "tests", "-v"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": "test",
      "problemMatcher": []
    }
  ]
}
